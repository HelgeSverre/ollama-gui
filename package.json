{
  "name": "ollama-gui",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write src e2e",
    "lint": "eslint src/",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --coverage.include='src/**/*.{ts,vue}' --coverage.exclude='src/**/*.test.ts'",
    "format:check": "prettier --check src e2e",
    "catalog:update": "bun scripts/build-model-catalog.ts",
    "ci:local": "docker pull -q catthehacker/ubuntu:act-latest >/dev/null && act"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@vueuse/core": "^15.0.0",
    "dexie": "^4.4.6",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "ollama-library-scraper": "^1.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
